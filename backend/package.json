{
  "name": "dataonchain-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "tsx scripts/db-check.ts",
    "test:auth": "tsx scripts/auth-smoke.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@circle-fin/adapter-circle-wallets": "^1.8.4",
    "@circle-fin/app-kit": "^1.19.0",
    "@circle-fin/developer-controlled-wallets": "^10.8.1",
    "@hono/node-server": "^2.1.3",
    "@libsql/client": "^0.18.0",
    "better-auth": "^1.7.7",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "resend": "^6.32.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
